---
// The site shell. Every page gets the same bar: the brand, the two views
// (Timeline and Map) as a switch, the record indexes, search, and a menu
// with About and the site's settings. Normal pages then get a main column and the
// attribution footer; `immersive` pages (the timeline and the map) fill the
// window instead, with the bar floating over them.
import "../styles/global.css"
import ThemeToggle from "../components/ThemeToggle.astro"
import Layers from "../components/Layers.astro"
import SiteSearch from "../components/SiteSearch.astro"
import { url } from "../lib/url.ts"

interface Props {
  title: string
  description?: string
  immersive?: boolean
}
const { title, description, immersive = false } = Astro.props
const path = Astro.url.pathname

const views = [
  ["Timeline", "/"],
  ["Map", "/map/"],
]
const indexes = [
  ["People", "/people/"],
  ["Places", "/places/"],
  ["Events", "/events/"],
]
const isCurrent = (href: string) =>
  href === "/" ? path === url("/") || path === url("") : path.startsWith(url(href))
const current = (href: string) => (isCurrent(href) ? "page" : undefined)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title === "Biblia Chronos" ? title : `${title} · Biblia Chronos`}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
    <!-- Installable as an app (see manifest.webmanifest.ts and public/sw.js) -->
    <link rel="manifest" href={url("/manifest.webmanifest")} />
    <link rel="apple-touch-icon" href={url("/icons/icon-180.png")} />
    <meta name="apple-mobile-web-app-title" content="Chronos" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="theme-color" content="#f7f3ea" />
    <script is:inline>
      // Scripts run: islands can hide their server drawing until they've
      // laid themselves out (see Timeline.svelte).
      document.documentElement.classList.add("js")
      // Set the theme before first paint, from the saved choice or the system
      // setting; the app's title bar follows it.
      window.applyTheme = (theme) => {
        document.documentElement.dataset.theme = theme
        document.querySelector('meta[name="theme-color"]').content = theme === "dark" ? "#1d1b18" : "#f7f3ea"
      }
      applyTheme(localStorage.getItem("theme") ?? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light"))
      // Draft records are shown unless hidden from the menu.
      document.documentElement.dataset.drafts = localStorage.getItem("drafts") ?? "shown"
    </script>
    {
      immersive && (
        <script is:inline>
          // The installed app opens on the view you were last in, the timeline
          // or the map. It launches at ?app (see manifest.webmanifest.ts), but
          // an app keeps the start URL it was installed with, so a launch is
          // also any fresh load running as an app that no page of ours led to
          // (not a link, a reload, or back/forward).
          try {
            const app = matchMedia("(display-mode: standalone)").matches || navigator.standalone
            const fresh = performance.getEntriesByType("navigation")[0]?.type === "navigate" && !document.referrer
            const launch = location.search === "?app" || (app && fresh)
            const last = localStorage.getItem("view")
            if (launch && last && last !== location.pathname) location.replace(last)
            else localStorage.setItem("view", location.pathname)
          } catch {}
        </script>
      )
    }
    <slot name="head" />
  </head>
  <body class:list={{ immersive }}>
    <header class:list={["bar", { overlay: immersive }]}>
      <a class="brand" href={url("/")}>Biblia Chronos</a>
      <nav class="views" aria-label="Views">
        {views.map(([label, href]) => <a href={url(href)} aria-current={current(href)}>{label}</a>)}
      </nav>
      <nav class="indexes" aria-label="Records">
        {indexes.map(([label, href]) => <a href={url(href)} aria-current={current(href)}>{label}</a>)}
      </nav>
      <SiteSearch />
      <details class="menu">
        <summary class="icon-button" aria-label="Menu">
          <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </summary>
        <div class="sheet">
          <nav class="menu-indexes" aria-label="Records">
            {indexes.map(([label, href]) => <a href={url(href)} aria-current={current(href)}>{label}</a>)}
          </nav>
          <a href={url("/about/")} aria-current={current("/about/")}>About & sources</a>
          <hr />
          <ThemeToggle />
          <label class="row">
            <input type="checkbox" class="drafts-toggle" checked />
            Show draft records
          </label>
          <p>
            Data: <a href="https://github.com/robertrouse/theographic-bible-metadata">Theographic</a> (CC BY-SA 4.0)
          </p>
        </div>
      </details>
    </header>
    <main class={immersive ? "immersive" : "column"}>
      <slot />
    </main>
    {
      !immersive && (
        <footer class="site">
          Data from <a href="https://github.com/robertrouse/theographic-bible-metadata">Theographic Bible Metadata</a>
          (CC BY-SA 4.0), with descriptions from Easton's Bible Dictionary.{" "}
          <a href={url("/about/")}>Sources & credits</a>.
        </footer>
      )
    }
    <Layers />
    <script>
      // Offline support for the installed app. Production only: in dev it
      // would serve stale pages.
      import { url } from "../lib/url.ts"
      if (import.meta.env.PROD && "serviceWorker" in navigator) navigator.serviceWorker.register(url("/sw.js"))

      // The menu closes on a click outside it, on Esc, and once you pick
      // something in it that isn't a setting.
      const menu = document.querySelector<HTMLDetailsElement>("header.bar .menu")!
      document.addEventListener("click", (e) => {
        const inside = menu.contains(e.target as Node)
        if (!inside || (e.target as Element).closest(".sheet a")) menu.open = false
      })
      menu.addEventListener("keydown", (e) => {
        if (e.key !== "Escape" || !menu.open) return
        e.stopPropagation()
        menu.open = false
        menu.querySelector("summary")!.focus()
      })

      // Draft records: a site-wide setting, remembered. Islands that show
      // records (the timeline) listen for the "drafts" event.
      const drafts = menu.querySelector<HTMLInputElement>(".drafts-toggle")!
      drafts.checked = document.documentElement.dataset.drafts !== "hidden"
      drafts.addEventListener("change", () => {
        const value = drafts.checked ? "shown" : "hidden"
        document.documentElement.dataset.drafts = value
        localStorage.setItem("drafts", value)
        dispatchEvent(new CustomEvent("drafts", { detail: drafts.checked }))
      })
    </script>
  </body>
</html>

<style>
  /* --- The bar, the same on every page --- */
  header.bar {
    position: sticky;
    top: 0;
    z-index: 40; /* above panels (Layers.astro), so search results show over them */
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: calc(var(--bar-h) + env(safe-area-inset-top));
    padding: env(safe-area-inset-top) max(1.5rem, env(safe-area-inset-right)) 0 max(1.5rem, env(safe-area-inset-left));
    background: color-mix(in srgb, var(--paper) 86%, transparent);
    backdrop-filter: blur(10px) saturate(1.2);
    -webkit-backdrop-filter: blur(10px) saturate(1.2);
    border-bottom: 1px solid var(--rule);
  }
  /* Over the timeline and the map it floats, so the canvas runs underneath. */
  header.bar.overlay {
    position: fixed;
    inset: 0 0 auto;
  }
  .brand {
    flex: none;
    font: 600 1.15rem var(--serif);
    color: var(--ink);
    text-decoration: none;
  }

  /* Timeline and Map: a switch, since they're two ways of seeing one story. */
  .views {
    display: flex;
    padding: 3px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--surface);
  }
  .views a {
    padding: 0.28rem 0.9rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--ink-2);
    text-decoration: none;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .views a:hover {
    color: var(--ink);
  }
  .views a[aria-current="page"] {
    background: var(--gold);
    color: var(--paper);
  }

  .indexes {
    flex: 1;
    display: flex;
    gap: 1.1rem;
    font-size: 0.9rem;
  }
  .indexes a,
  .menu-indexes a {
    color: var(--ink-2);
    text-decoration: none;
    padding: 2px 0;
    border-bottom: 2px solid transparent;
  }
  .indexes a:hover {
    color: var(--ink);
  }
  .indexes a[aria-current="page"] {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }

  /* --- The menu: About, appearance, and settings (and, on phones, the indexes) --- */
  .menu {
    position: relative;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu[open] summary {
    color: var(--ink);
    border-color: var(--gold);
  }
  .menu[open] .sheet {
    animation: drop 0.16s ease-out;
  }
  @keyframes drop {
    from {
      opacity: 0;
      transform: translateY(-4px) scale(0.98);
    }
  }
  .sheet {
    position: absolute;
    right: 0;
    top: calc(100% + 0.6rem);
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 14rem;
    padding: 0.5rem;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 12px;
    box-shadow: 0 10px 30px rgb(40 30 15 / 0.15);
    font-size: 0.9rem;
  }
  .sheet > a,
  .sheet .menu-indexes a,
  .sheet :global(.row) {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 0.6rem;
    border: 0;
    border-radius: 8px;
    color: var(--ink);
    text-decoration: none;
    cursor: pointer;
  }
  .sheet > a:hover,
  .sheet .menu-indexes a:hover,
  .sheet :global(.row:hover) {
    background: var(--wash);
  }
  .sheet a[aria-current="page"] {
    font-weight: 600;
  }
  .menu-indexes {
    display: none;
    flex-direction: column;
    gap: 0.15rem;
  }
  .row input {
    margin: 0;
    accent-color: var(--gold);
  }
  .sheet hr {
    width: 100%;
    margin: 0.3rem 0;
    border: 0;
    border-top: 1px solid var(--rule);
  }
  .sheet p {
    margin: 0.3rem 0 0;
    padding: 0.5rem 0.6rem 0.2rem;
    border-top: 1px solid var(--rule);
    font-size: 0.75rem;
    color: var(--ink-3);
  }
  .sheet p a {
    color: inherit;
  }

  /* Phones: the bar keeps the brand, the switch, and the menu; the indexes
     move into the menu. */
  @media (max-width: 700px) {
    header.bar {
      gap: 0.75rem;
      padding-left: max(1rem, env(safe-area-inset-left));
      padding-right: max(1rem, env(safe-area-inset-right));
    }
    .brand {
      font-size: 1.05rem;
    }
    .views a {
      padding: 0.25rem 0.7rem;
    }
    .indexes {
      display: none;
    }
    .menu-indexes {
      display: flex;
    }
    .menu-indexes::after {
      content: "";
      margin: 0.3rem 0;
      border-top: 1px solid var(--rule);
    }
  }
  @media (max-width: 360px) {
    .brand {
      font-size: 0.95rem;
    }
  }

  main.column {
    max-width: 860px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 4rem;
  }
  footer.site {
    padding: 1.25rem 1.5rem 2rem;
    border-top: 1px solid var(--rule);
    font-size: 0.8rem;
    color: var(--ink-3);
  }
  footer.site a {
    color: inherit;
  }

  /* --- Immersive ----------------------------------------------------------- */

  /* A canvas, not a document: no page scroll, no pull-to-refresh bounce. */
  body.immersive {
    overflow: hidden;
    overscroll-behavior: none;
  }
  /* Pinned to the window, not 100dvh: an installed app reopening straight
     into the map can measure 100dvh taller than it shows, hiding the bottom
     of the chapter sheet. */
  main.immersive {
    position: fixed;
    inset: 0;
  }
</style>
