---
// The site shell. Normal pages get the header nav, a main column, and the
// attribution footer. `immersive` pages (the timeline and the map) fill the
// window instead, with the brand and a few tools floating over them and the
// nav tucked into a menu.
import "../styles/global.css"
import ThemeToggle from "../components/ThemeToggle.astro"
import Layers from "../components/Layers.astro"
import { url } from "../lib/url.ts"

interface Props {
  title: string
  description?: string
  immersive?: boolean
}
const { title, description, immersive = false } = Astro.props
const path = Astro.url.pathname

const nav = [
  ["Timeline", "/"],
  ["Map", "/map/"],
  ["People", "/people/"],
  ["Places", "/places/"],
  ["Events", "/events/"],
  ["About", "/about/"],
]
const isCurrent = (href: string) =>
  href === "/" ? path === url("/") || path === url("") : path.startsWith(url(href))
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title === "Biblia Chronos" ? title : `${title} · Biblia Chronos`}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
    <!-- Installable as an app (see manifest.webmanifest.ts and public/sw.js) -->
    <link rel="manifest" href={url("/manifest.webmanifest")} />
    <link rel="apple-touch-icon" href={url("/icons/icon-180.png")} />
    <meta name="apple-mobile-web-app-title" content="Chronos" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="theme-color" content="#f7f3ea" />
    <script is:inline>
      // Set the theme before first paint, from the saved choice or the system
      // setting; the app's title bar follows it.
      window.applyTheme = (theme) => {
        document.documentElement.dataset.theme = theme
        document.querySelector('meta[name="theme-color"]').content = theme === "dark" ? "#1d1b18" : "#f7f3ea"
      }
      applyTheme(localStorage.getItem("theme") ?? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light"))
    </script>
    <slot name="head" />
  </head>
  <body class:list={{ immersive }}>
    {
      immersive ? (
        <header class="overlay">
          <a class="brand" href={url("/")}>
            Biblia Chronos
            <small>The History of Israel</small>
          </a>
          <div class="tools">
            <ThemeToggle />
            <details class="menu">
              <summary class="icon-button" aria-label="Menu">
                <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                </svg>
              </summary>
              <nav aria-label="Main">
                {nav.map(([label, href]) => (
                  <a href={url(href)} aria-current={isCurrent(href) ? "page" : undefined}>
                    {label}
                  </a>
                ))}
                <p>
                  Data: <a href="https://github.com/robertrouse/theographic-bible-metadata">Theographic</a> (CC
                  BY-SA 4.0)
                </p>
              </nav>
            </details>
          </div>
        </header>
      ) : (
        <header class="site">
          <a class="brand" href={url("/")}>
            Biblia Chronos
          </a>
          <nav aria-label="Main">
            {nav.map(([label, href]) => (
              <a href={url(href)} aria-current={isCurrent(href) ? "page" : undefined}>
                {label}
              </a>
            ))}
          </nav>
          <ThemeToggle />
        </header>
      )
    }
    <main class={immersive ? "immersive" : "column"}>
      <slot />
    </main>
    {
      !immersive && (
        <footer class="site">
          Data from <a href="https://github.com/robertrouse/theographic-bible-metadata">Theographic Bible Metadata</a>
          (CC BY-SA 4.0), with descriptions from Easton's Bible Dictionary.{" "}
          <a href={url("/about/")}>Sources & credits</a>.
        </footer>
      )
    }
    <Layers />
    <script>
      // Offline support for the installed app. Production only: in dev it
      // would serve stale pages.
      import { url } from "../lib/url.ts"
      if (import.meta.env.PROD && "serviceWorker" in navigator) navigator.serviceWorker.register(url("/sw.js"))
    </script>
  </body>
</html>

<style>
  header.site {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.75rem;
    padding: 0.7rem 1.5rem;
    border-bottom: 1px solid var(--rule);
  }
  .brand {
    font: 600 1.2rem var(--serif);
    color: var(--ink);
    text-decoration: none;
  }
  header.site nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.1rem;
    font-size: 0.92rem;
    flex: 1;
  }
  nav a {
    color: var(--ink-2);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 2px solid transparent;
  }
  nav a:hover {
    color: var(--ink);
  }
  nav a[aria-current="page"] {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }
  main.column {
    max-width: 860px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 4rem;
  }
  footer.site {
    padding: 1.25rem 1.5rem 2rem;
    border-top: 1px solid var(--rule);
    font-size: 0.8rem;
    color: var(--ink-3);
  }
  footer.site a {
    color: inherit;
  }

  /* --- Immersive ----------------------------------------------------------- */

  /* A canvas, not a document: no page scroll, no pull-to-refresh bounce. */
  body.immersive {
    overflow: hidden;
    overscroll-behavior: none;
  }
  main.immersive {
    height: 100dvh;
  }
  header.overlay {
    position: fixed;
    inset: 0 0 auto;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: max(1.1rem, env(safe-area-inset-top)) max(1.5rem, env(safe-area-inset-right)) 1.1rem
      max(1.5rem, env(safe-area-inset-left));
    pointer-events: none;
  }
  header.overlay > * {
    pointer-events: auto;
  }
  header.overlay .brand small {
    display: block;
    margin-top: 0.1rem;
    font: 500 0.62rem var(--sans);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .tools {
    display: flex;
    gap: 0.5rem;
  }
  .menu {
    position: relative;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu[open] nav {
    animation: drop 0.16s ease-out;
  }
  @keyframes drop {
    from {
      opacity: 0;
      transform: translateY(-4px) scale(0.98);
    }
  }
  .menu nav {
    position: absolute;
    right: 0;
    top: 2.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 12rem;
    padding: 0.9rem 1.1rem;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 10px;
    box-shadow: 0 10px 30px rgb(40 30 15 / 0.15);
  }
  .menu nav p {
    margin: 0.4rem 0 0;
    padding-top: 0.6rem;
    border-top: 1px solid var(--rule);
    font-size: 0.75rem;
    color: var(--ink-3);
  }
  .menu nav p a {
    color: inherit;
    border: 0;
  }
</style>
