---
// The site shell: header nav, a main column, and the attribution footer.
// `wide` lets visualizations use the full window instead of the reading column.
import "../styles/global.css"
import { url } from "../lib/url.ts"

interface Props {
  title: string
  description?: string
  wide?: boolean
}
const { title, description, wide = false } = Astro.props
const path = Astro.url.pathname

const nav = [
  ["Timeline", "/"],
  ["Map", "/map/"],
  ["People", "/people/"],
  ["Places", "/places/"],
  ["Events", "/events/"],
  ["About", "/about/"],
]
const isCurrent = (href: string) =>
  href === "/" ? path === url("/") || path === url("") : path.startsWith(url(href))
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === "Biblia Chronos" ? title : `${title} · Biblia Chronos`}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
    <slot name="head" />
  </head>
  <body>
    <header class="site">
      <a class="brand" href={url("/")}>Biblia Chronos</a>
      <nav aria-label="Main">
        {
          nav.map(([label, href]) => (
            <a href={url(href)} aria-current={isCurrent(href) ? "page" : undefined}>
              {label}
            </a>
          ))
        }
      </nav>
    </header>
    <main class:list={[wide ? "wide" : "column"]}>
      <slot />
    </main>
    <footer class="site">
      Data from <a href="https://github.com/robertrouse/theographic-bible-metadata">Theographic Bible Metadata</a>
      (CC BY-SA 4.0), with descriptions from Easton's Bible Dictionary. <a href={url("/about/")}>Sources & credits</a>.
    </footer>
  </body>
</html>

<style>
  header.site {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.75rem;
    padding: 0.9rem 1.5rem;
    border-bottom: 1px solid var(--rule);
  }
  .brand {
    font: 600 1.2rem var(--serif);
    color: var(--ink);
    text-decoration: none;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.1rem;
    font-size: 0.92rem;
  }
  nav a {
    color: var(--ink-2);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 2px solid transparent;
  }
  nav a:hover {
    color: var(--ink);
  }
  nav a[aria-current="page"] {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }
  main.column {
    max-width: 860px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 4rem;
  }
  main.wide {
    padding: 1.25rem 1.5rem 2rem;
  }
  footer.site {
    padding: 1.25rem 1.5rem 2rem;
    border-top: 1px solid var(--rule);
    font-size: 0.8rem;
    color: var(--ink-3);
  }
  footer.site a {
    color: inherit;
  }
</style>
