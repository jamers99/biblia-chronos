---
// Connections: pick any two people, places, or events and see the chain of
// links between them (lib/connections.ts). Names come from the search index,
// links from /connections.json; both are fetched when the page opens. The
// choice lives in the URL (?from=…&to=…), so a chain can be shared.
import Page from "../../layouts/Page.astro"
---

<Page title="Connections" description="Pick any two people, places, or events and see how Scripture links them.">
  <h1>Connections</h1>
  <p class="muted lede">Pick any two people, places, or events to see how Scripture links them.</p>

  <form class="ends" autocomplete="off">
    {
      ["from", "to"].map((end) => (
        <div class="end" data-end={end}>
          <label for={`end-${end}`}>{end === "from" ? "From" : "To"}</label>
          <input
            id={`end-${end}`}
            type="search"
            placeholder={end === "from" ? "Ruth" : "David"}
            role="combobox"
            aria-expanded="false"
            aria-controls={`end-${end}-results`}
            aria-autocomplete="list"
            spellcheck="false"
          />
          <ul id={`end-${end}-results`} class="results" role="listbox" hidden />
        </div>
      ))
    }
    <label class="family">
      <input type="checkbox" name="family" />
      Family only
    </label>
  </form>

  <div class="found" aria-live="polite"></div>
</Page>

<script>
  import { prepare, search, KIND_LABEL, type Prepared, type SearchEntry } from "../../lib/search.ts"
  import { createRouter, linkLabel, type ConnectionsData, type Step } from "../../lib/connections.ts"
  import { verse } from "../../lib/scripture.ts"
  import { entityUrl, url } from "../../lib/url.ts"
  import { REPORT } from "../../lib/review.ts"

  const json = <T,>(path: string): Promise<T> => fetch(url(path)).then((r) => (r.ok ? r.json() : Promise.reject(r.statusText)))
  const ready = Promise.all([json<SearchEntry[]>("/search.json"), json<ConnectionsData>("/connections.json")])

  const form = document.querySelector<HTMLFormElement>("form.ends")!
  const found = document.querySelector<HTMLElement>(".found")!
  const family = form.querySelector<HTMLInputElement>('[name="family"]')!
  const chosen: Record<"from" | "to", string | undefined> = { from: undefined, to: undefined }

  ready.then(([entries, data]) => {
    // Eras aren't in the links, so they can't be an end.
    const records = entries.filter((e) => e.kind !== "period")
    const byId = new Map(records.map((e) => [e.id, e]))
    const index = prepare(records)
    const router = createRouter(data)
    const female = new Set(data.female)
    const showDrafts = () => document.documentElement.dataset.drafts !== "hidden"

    const ends = [...form.querySelectorAll<HTMLElement>(".end")].map((el) => picker(el, index, showDrafts, show))

    // Start from the URL.
    const params = new URLSearchParams(location.search)
    for (const end of ends) {
      const entry = byId.get(params.get(end.name) ?? "")
      if (entry) end.set(entry)
    }
    family.checked = params.has("family")
    family.addEventListener("change", show)
    show()
    if (chosen.from && !chosen.to) ends[1].focus()

    function show() {
      const { from, to } = chosen
      const params = new URLSearchParams()
      if (from) params.set("from", from)
      if (to) params.set("to", to)
      if (family.checked) params.set("family", "")
      const query = params.toString().replace(/=(&|$)/g, "$1")
      history.replaceState(history.state, "", query ? `?${query}` : location.pathname)

      if (!from || !to) return found.replaceChildren()
      if (from === to) return say("Pick two different records.")
      const unlinked = [from, to].filter((id) => !router.linked(id))
      if (unlinked.length) return say(`${unlinked.map((id) => byId.get(id)!.name).join(" and ")} ${unlinked.length > 1 ? "have" : "has"} no recorded links yet.`, true)
      const routes = router.routes(from, to, family.checked)
      if (!routes.length)
        return say(`No connection found${family.checked ? " through family. Try without “Family only”" : ""}.`, true)
      found.replaceChildren(
        ...routes.flatMap((steps, i) => [
          Object.assign(document.createElement("h2"), {
            textContent: `${i ? "Another way" : "The closest link"}: ${steps.length - 1} ${steps.length === 2 ? "step" : "steps"}`,
          }),
          chain(steps),
        ]),
      )
    }

    // A message, and for a gap, a way to report it.
    function say(text: string, gap = false) {
      const p = Object.assign(document.createElement("p"), { className: "muted", textContent: `${text} ` })
      if (gap) {
        p.append("Many links are still missing from the data: ")
        const a = Object.assign(document.createElement("a"), { className: "report", href: REPORT, target: "_blank", rel: "noopener", textContent: "suggest one" })
        a.dataset.title = "Missing link: "
        p.append(a, ".")
      }
      found.replaceChildren(p)
    }

    // Each record, with how it links to the one before: "mother of · Ruth 4:13".
    function chain(steps: Step[]) {
      const ol = Object.assign(document.createElement("ol"), { className: "chain" })
      steps.forEach((step, i) => {
        const entry = byId.get(step.id)
        const li = document.createElement("li")
        if (step.type) {
          const via = Object.assign(document.createElement("span"), {
            className: "via",
            textContent: linkLabel(step.type, step.forward!, female.has(steps[i - 1].id)),
          })
          const cite = step.verse && verse(step.verse, data.books)
          if (cite) {
            via.append(" · ")
            via.append(Object.assign(document.createElement("a"), { href: cite.url, target: "_blank", rel: "noopener", textContent: cite.short, title: cite.long }))
          }
          li.append(via)
        }
        const name = entry && entry.kind !== "period"
          ? Object.assign(document.createElement("a"), { href: entityUrl({ kind: entry.kind, id: entry.id }), textContent: entry.name })
          : Object.assign(document.createElement("span"), { textContent: step.id })
        name.classList.add("name")
        const hint = Object.assign(document.createElement("small"), {
          textContent: entry ? [KIND_LABEL[entry.kind], entry.hint].filter(Boolean).join(" · ") : "",
        })
        li.append(name, " ", hint)
        ol.append(li)
      })
      return ol
    }
  })
  ready.catch(() => (found.innerHTML = `<p class="muted">Couldn't load the links. Check your connection and reload.</p>`))

  // One end: a box that suggests records as you type. Choosing one fills it;
  // typing again clears the choice.
  function picker(el: HTMLElement, index: Prepared[], showDrafts: () => boolean, changed: () => void) {
    const name = el.dataset.end as "from" | "to"
    const input = el.querySelector("input")!
    const list = el.querySelector("ul")!
    let results: SearchEntry[] = []
    let active = 0

    function set(entry: SearchEntry) {
      input.value = entry.name
      chosen[name] = entry.id
      open(false)
    }
    function choose(entry: SearchEntry) {
      set(entry)
      changed()
    }
    function open(yes: boolean) {
      list.hidden = !yes
      input.ariaExpanded = String(yes)
    }
    function render() {
      list.replaceChildren(
        ...results.map((r, i) => {
          const li = document.createElement("li")
          li.id = `${list.id}-${i}`
          li.role = "option"
          li.ariaSelected = String(i === active)
          li.append(Object.assign(document.createElement("span"), { textContent: r.name }))
          li.append(Object.assign(document.createElement("small"), { textContent: [KIND_LABEL[r.kind], r.hint].filter(Boolean).join(" · ") }))
          li.addEventListener("pointerdown", (e) => e.preventDefault()) // keep focus in the box
          li.addEventListener("click", () => choose(r))
          return li
        }),
      )
      open(results.length > 0)
      if (results.length) input.setAttribute("aria-activedescendant", `${list.id}-${active}`)
      else input.removeAttribute("aria-activedescendant")
    }

    input.addEventListener("input", () => {
      if (chosen[name]) {
        chosen[name] = undefined
        changed()
      }
      results = search(index, input.value, 8, (e) => e.kind !== "period" && (showDrafts() || !e.draft))
      active = 0
      render()
    })
    input.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown" && results.length) active = (active + 1) % results.length
      else if (e.key === "ArrowUp" && results.length) active = (active - 1 + results.length) % results.length
      else if (e.key === "Enter") return void (e.preventDefault(), results[active] && !list.hidden && choose(results[active]))
      else if (e.key === "Escape" && !list.hidden) return void (e.preventDefault(), open(false))
      else return
      e.preventDefault()
      render()
    })
    input.addEventListener("blur", () => open(false))
    input.addEventListener("focus", () => results.length && !chosen[name] && open(true))
    return { name, set, focus: () => input.focus() }
  }
</script>

<style>
  .lede {
    margin-top: -0.25rem;
  }
  .ends {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 0.75rem 1rem;
    margin: 1.5rem 0 2rem;
  }
  .end {
    position: relative;
    flex: 1 1 14rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .end label {
    font-size: 0.75rem;
    color: var(--ink-3);
  }
  .end input {
    font: inherit;
    padding: 0.5rem 0.8rem;
    border-radius: var(--radius);
    border: 1px solid var(--rule);
    background: var(--surface);
    color: var(--ink);
  }
  .end input:focus {
    outline: none;
    border-color: var(--gold);
  }
  .family {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0;
    font-size: 0.9rem;
    color: var(--ink-2);
    cursor: pointer;
  }

  /* rows are made by the script, so they carry no scoping attribute: :global */
  .results {
    position: absolute;
    top: calc(100% + 0.3rem);
    left: 0;
    right: 0;
    z-index: 5;
    max-height: min(22rem, 60dvh);
    overflow-y: auto;
    list-style: none;
    margin: 0;
    padding: 0.3rem;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 10px;
    box-shadow: 0 10px 30px rgb(40 30 15 / 0.15);
  }
  .results :global(li) {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.45rem 0.65rem;
    border-radius: 7px;
    font-size: 0.9rem;
    cursor: pointer;
  }
  .results :global(li[aria-selected="true"]),
  .results :global(li:hover) {
    background: var(--wash);
  }
  .results :global(small),
  .found :global(small) {
    color: var(--ink-3);
    font-size: 0.75rem;
  }
  .results :global(small) {
    flex: none;
    max-width: 55%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* The chain: each record, and between them a rule with the link beside it */
  .found :global(h2) {
    font: 600 1rem var(--sans);
    color: var(--ink-2);
    margin: 2rem 0 0.75rem;
  }
  .found :global(h2:first-child) {
    margin-top: 0;
  }
  .found :global(.chain) {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .found :global(.via) {
    display: block;
    margin: 0.3rem 0 0.3rem 0.6rem;
    padding: 0.35rem 0 0.35rem 1rem;
    border-left: 2px solid var(--gold);
    font-size: 0.85rem;
    font-style: italic;
    color: var(--ink-2);
  }
  .found :global(.via a) {
    font-style: normal;
    color: var(--ink-3);
  }
  .found :global(.name) {
    font: 1.15rem/1.4 var(--serif);
  }
</style>
