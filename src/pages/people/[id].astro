---
import Page from "../../layouts/Page.astro"
import EntityHeader from "../../components/EntityHeader.astro"
import Description from "../../components/Description.astro"
import Relations from "../../components/Relations.astro"
import DescendantTree from "../../components/DescendantTree.astro"
import EventList from "../../components/EventList.astro"
import Scripture from "../../components/Scripture.astro"
import Sources from "../../components/Sources.astro"
import { people, periods, graph, resolve, eventsOf } from "../../lib/data/load.ts"
import { edgeFact, recordFact } from "../../lib/evidence.ts"
import type { Person } from "../../lib/data/schema.ts"
import { personSpan, periodsOverlapping } from "../../lib/chronology.ts"
import { lineage } from "../../lib/family.ts"
import { formatEstimate, formatSpan, label, summarize } from "../../lib/format.ts"
import { entityUrl } from "../../lib/url.ts"

export const getStaticPaths = () => people.map((person) => ({ params: { id: person.id }, props: { person } }))

const { person } = Astro.props as { person: Person }
const id = person.id
const parentsOf = (pid: string) => resolve(graph.incoming(pid, "parent-of"), "person")
const children = resolve(graph.outgoing(id, "parent-of"), "person")
const events = eventsOf(id)
const span = personSpan(person, events)
const eras = span ? periodsOverlapping(span, periods) : []
const line = lineage(person, parentsOf)
const hasGrandchildren = children.some((c) => graph.outgoing(c.id, "parent-of").length > 0)

const facts: [string, string | undefined, string?][] = [
  ["Born", person.birth && formatEstimate(person.birth), recordFact("birth", id)],
  ["Died", person.death && formatEstimate(person.death), recordFact("death", id)],
  ["Mentioned", span && !span.lifetime ? `${formatSpan(span.start, span.end)} · lifespan unknown` : undefined],
  ["Era", eras.map((p) => p.name).join(", ") || undefined],
]
---

<Page title={label(person)} description={summarize(person.description)}>
  <EntityHeader entity={person} kindLabel="Person" subtitle={person.displayTitle} facts={facts} />

  <h2>Family & connections</h2>
  <Relations
    context={id}
    rows={[
      ["Parents", parentsOf(id), (e) => edgeFact("parent-of", e.id, id)],
      ["Partners", resolve(graph.either(id, "partner-of"), "person"), (e) => edgeFact("partner-of", id, e.id)],
      ["Siblings", resolve(graph.either(id, "sibling-of"), "person")],
      ["Half-siblings", resolve(graph.either(id, "half-sibling-of"), "person")],
      ["Children", children, (e) => edgeFact("parent-of", id, e.id)],
      ["Member of", resolve(graph.outgoing(id, "member-of"), "peopleGroup"), (e) => edgeFact("member-of", id, e.id)],
      ["Visited", resolve(graph.outgoing(id, "visited"), "place"), (e) => edgeFact("visited", id, e.id)],
      ["Died at", resolve(graph.outgoing(id, "died-at"), "place"), (e) => edgeFact("died-at", id, e.id)],
    ]}
  />

  {
    line.length > 2 && (
      <section>
        <h2>Line of descent</h2>
        <p class="muted small">
          {line.length - 1} generations back to {line[0].name}, following the father where one is recorded.
        </p>
        <ol class="line">
          {line.map((p) => (
            <li>{p.id === id ? <strong>{label(p)}</strong> : <a href={entityUrl(p)}>{label(p)}</a>}</li>
          ))}
        </ol>
      </section>
    )
  }

  {
    hasGrandchildren && (
      <section>
        <h2>Descendants</h2>
        <p class="muted small">Three generations.</p>
        <DescendantTree person={person} depth={3} />
      </section>
    )
  }

  {
    events.length > 0 && (
      <section>
        <h2>Events</h2>
        <EventList events={events} context={id} factOf={(e) => edgeFact("participated-in", id, e.id)} />
      </section>
    )
  }

  <Description text={person.description} />
  <Scripture refs={person.scriptureRefs} />
  <Sources record={person} />
</Page>

<style>
  .small {
    font-size: 0.85rem;
    margin-top: -0.25rem;
  }
  .line {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0;
    font-family: var(--serif);
  }
  .line li:not(:last-child)::after {
    content: "→";
    color: var(--ink-3);
    margin: 0 0.45rem;
  }
</style>
