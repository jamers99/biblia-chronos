---
import Page from "../../layouts/Page.astro"
import PlaceMap from "../../components/PlaceMap.svelte"
import { places, periods, graph, resolve, eventsOf } from "../../lib/data/load.ts"
import { personSpan, spanOf } from "../../lib/chronology.ts"
import { mapPlaces, mapStandIn } from "../../lib/map.ts"
import { project, MAP_W, MAP_H } from "../../lib/geo.ts"
import { url } from "../../lib/url.ts"

// Aliases and spots inside a city are drawn as the place they stand for, so
// each dot gathers the places it stands for.
const standIn = (p: (typeof places)[number]) => mapStandIn(p, graph.outgoing, (id) => resolve([id], "place")[0])
const drawnAs = Map.groupBy(places, standIn)

// When a place matters: the dated events that happened there, and the
// lifetimes of the people who visited or died there.
const spansAt = (dotId: string) =>
  (drawnAs.get(dotId) ?? []).flatMap(({ id }) =>
    [
      ...resolve(graph.incoming(id, "occurred-at"), "event").map((e) => spanOf(e.date)),
      ...resolve([...graph.incoming(id, "visited"), ...graph.incoming(id, "died-at")], "person").map((p) =>
        personSpan(p, eventsOf(p.id)),
      ),
    ].filter((s) => s !== undefined),
  )

const located = mapPlaces(
  places.filter((p) => standIn(p) === p.id),
  periods,
  (p) => p.coordinates && project(p.coordinates),
  spansAt,
)
const eras = periods.map(({ id, name }) => ({ id, name }))

// Opening view: Egypt to Mesopotamia.
const [x0, y1] = project({ lng: 28, lat: 27 })!
const [x1, y0] = project({ lng: 48, lat: 38 })!
---

<Page title="Map" description="The places of Scripture on a map, era by era." wide>
  <!-- Start the basemap download now rather than after the island hydrates.
       crossorigin matches fetch()'s request mode, so it isn't downloaded twice. -->
  <link slot="head" rel="preload" as="fetch" crossorigin="anonymous" href={url("/map/basemap.svg")} />
  <div class="intro">
    <h1>Places of Scripture</h1>
    <p>
      {located.length.toLocaleString()} places with known locations. Locations come from the source data and many are
      uncertain; see <a href={url("/about/")}>sources</a>.
    </p>
  </div>
  <PlaceMap
    client:load
    places={located}
    periods={eras}
    basemap={url("/map/basemap.svg")}
    mapWidth={MAP_W}
    mapHeight={MAP_H}
    home={[x0, y0, x1, y1]}
  />
</Page>
