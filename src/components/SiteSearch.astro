---
// Search, in the site bar on every page: people, places, events, groups, and
// eras. The index (/search.json, see lib/search.ts) is fetched the first time
// you reach for the box, so pages don't pay for it up front. "/" focuses it.
//
// Picking a result fires a cancelable "search-pick" event first, so the view
// you're in can show it in place (the timeline flies to a person, the map to
// a place). Otherwise it opens as a panel (see Layers.astro); an era opens on
// the timeline.
//
// On phones the bar has no room for a box, so a button opens the search over
// the bar.
---

<div class="site-search">
  <button type="button" class="icon-button search-open" aria-label="Search">
    <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
      <circle cx="11" cy="11" r="6.5"></circle><path d="M16 16l4.5 4.5"></path>
    </svg>
  </button>
  <div class="field">
    <svg class="glass" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
      <circle cx="11" cy="11" r="6.5"></circle><path d="M16 16l4.5 4.5"></path>
    </svg>
    <input
      type="search"
      placeholder="Search people, places, events…"
      aria-label="Search people, places, events, and eras"
      role="combobox"
      aria-expanded="false"
      aria-controls="site-search-results"
      aria-autocomplete="list"
      autocomplete="off"
      spellcheck="false"
    />
    <kbd aria-hidden="true">/</kbd>
    <button type="button" class="search-cancel">Cancel</button>
    <ul id="site-search-results" class="results" role="listbox" aria-label="Results" hidden></ul>
  </div>
</div>

<script>
  import { prepare, search, KIND_LABEL, type Prepared, type SearchEntry } from "../lib/search.ts"
  import { entityUrl, url } from "../lib/url.ts"

  const root = document.querySelector<HTMLElement>(".site-search")!
  const bar = root.closest("header")!
  const input = root.querySelector("input")!
  const list = root.querySelector<HTMLUListElement>(".results")!

  // The index, once. A failed fetch is retried on the next focus.
  let index: Promise<Prepared[]> | undefined
  function load() {
    index ??= fetch(url("/search.json"))
      .then((r) => (r.ok ? r.json() : Promise.reject(new Error(r.statusText))))
      .then((entries: SearchEntry[]) => prepare(entries))
    index.catch(() => (index = undefined))
    return index
  }

  let results: SearchEntry[] = []
  let active = 0

  const showDrafts = () => document.documentElement.dataset.drafts !== "hidden"
  async function update() {
    const query = input.value
    const found = query.trim() ? search(await load(), query, 8, (e) => showDrafts() || !e.draft) : []
    if (input.value !== query) return // typed on meanwhile
    results = found
    active = 0
    render()
  }

  function render() {
    list.replaceChildren(
      ...results.map((r, i) => {
        const li = document.createElement("li")
        li.id = `site-search-${i}`
        li.role = "option"
        li.ariaSelected = String(i === active)
        li.innerHTML = `<span class="name"></span><small></small>`
        li.querySelector(".name")!.textContent = r.name
        li.querySelector("small")!.textContent = [KIND_LABEL[r.kind], r.hint].filter(Boolean).join(" · ")
        if (r.draft) li.classList.add("draft")
        // Keep focus in the box while pressing (so it doesn't blur and close
        // the list mid-tap), and pick on click, so the tap ends here rather
        // than on whatever is under the list once it's gone.
        li.addEventListener("pointerdown", (e) => e.preventDefault())
        li.addEventListener("click", () => pick(r))
        li.addEventListener("pointermove", () => highlight(i))
        return li
      }),
    )
    if (input.value.trim().length > 1 && !results.length) {
      const li = Object.assign(document.createElement("li"), { className: "empty", textContent: "Nothing found" })
      list.append(li)
    }
    const open = list.children.length > 0
    list.hidden = !open
    input.ariaExpanded = String(open)
    if (results.length) input.setAttribute("aria-activedescendant", `site-search-${active}`)
    else input.removeAttribute("aria-activedescendant")
  }

  function highlight(i: number) {
    active = (i + results.length) % results.length
    for (const [n, li] of [...list.children].entries()) li.ariaSelected = String(n === active)
    input.setAttribute("aria-activedescendant", `site-search-${active}`)
    list.children[active]?.scrollIntoView({ block: "nearest" })
  }

  function close() {
    input.value = ""
    results = []
    render()
    bar.classList.remove("searching")
    input.blur()
  }

  function pick(entry: SearchEntry) {
    close()
    const shown = !dispatchEvent(new CustomEvent("search-pick", { detail: entry, cancelable: true }))
    if (shown) return
    const { kind, id } = entry
    if (kind === "period") location.href = url(`/#${id}`)
    else dispatchEvent(new CustomEvent("open-layer", { detail: entityUrl({ kind, id }) }))
  }

  input.addEventListener("focus", () => void load())
  root.addEventListener("pointerover", () => void load(), { once: true })
  input.addEventListener("input", update)
  input.addEventListener("keydown", (e) => {
    if (e.key === "ArrowDown" && results.length) highlight(active + 1)
    else if (e.key === "ArrowUp" && results.length) highlight(active - 1)
    else if (e.key === "Enter" && results[active]) pick(results[active])
    else if (e.key === "Escape") close()
    else return
    e.preventDefault()
    e.stopPropagation() // the page underneath (the timeline's keys) never sees these
  })
  // Leaving the box puts the results away (the query stays, for coming back).
  input.addEventListener("blur", () => {
    list.hidden = true
    input.ariaExpanded = "false"
    if (!input.value) bar.classList.remove("searching")
  })
  input.addEventListener("focus", () => {
    if (list.children.length) {
      list.hidden = false
      input.ariaExpanded = "true"
    }
  })

  // Phones: the button opens the search over the bar, Cancel puts it away.
  root.querySelector(".search-open")!.addEventListener("click", () => {
    bar.classList.add("searching")
    input.focus()
  })
  root.querySelector(".search-cancel")!.addEventListener("pointerdown", (e) => {
    e.preventDefault()
    close()
  })

  // "/" from anywhere but a text field.
  addEventListener("keydown", (e) => {
    const t = e.target as HTMLElement
    if (e.key !== "/" || e.metaKey || e.ctrlKey || t.isContentEditable || t instanceof HTMLInputElement || t instanceof HTMLTextAreaElement)
      return
    e.preventDefault()
    if (getComputedStyle(root.querySelector(".search-open")!).display !== "none") bar.classList.add("searching")
    input.focus()
  })
</script>

<style>
  .site-search {
    flex: 0 1 19rem;
    min-width: 11rem;
  }
  .field {
    position: relative;
    display: flex;
    align-items: center;
  }
  .glass {
    position: absolute;
    left: 0.8rem;
    color: var(--ink-3);
    pointer-events: none;
  }
  input {
    width: 100%;
    font: inherit;
    font-size: 0.85rem;
    padding: 0.42rem 2.2rem 0.42rem 2.1rem;
    border-radius: 999px;
    border: 1px solid var(--rule);
    background: var(--surface);
    color: var(--ink);
  }
  input:focus {
    outline: none;
    border-color: var(--gold);
  }
  input::-webkit-search-cancel-button {
    display: none;
  }
  kbd {
    position: absolute;
    right: 0.6rem;
    padding: 0 0.35rem;
    border: 1px solid var(--rule);
    border-radius: 4px;
    font: 0.7rem/1.4 var(--sans);
    color: var(--ink-3);
    pointer-events: none;
  }
  input:focus ~ kbd,
  input:not(:placeholder-shown) ~ kbd {
    display: none;
  }

  .results {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    width: max(100%, 24rem);
    max-height: min(26rem, 70dvh);
    overflow-y: auto;
    list-style: none;
    margin: 0;
    padding: 0.3rem;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 12px;
    box-shadow: 0 10px 30px rgb(40 30 15 / 0.15);
    animation: drop 0.15s ease-out;
  }
  @keyframes drop {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }
  /* rows are made by the script, so they carry no scoping attribute: :global */
  .results :global(li) {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.45rem 0.65rem;
    border-radius: 7px;
    font-size: 0.88rem;
    color: var(--ink);
    cursor: pointer;
  }
  .results :global(li[aria-selected="true"]) {
    background: var(--wash);
  }
  .results :global(li.draft .name) {
    color: var(--ink-2);
  }
  .results :global(small) {
    flex: none;
    max-width: 55%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--ink-3);
    font-size: 0.75rem;
  }
  .results :global(.empty) {
    color: var(--ink-3);
    cursor: default;
  }

  .search-open,
  .search-cancel {
    display: none;
  }

  /* Phones: a button in the bar; the search opens over the whole bar. */
  @media (max-width: 700px) {
    .site-search {
      flex: none;
      min-width: 0;
      margin-left: auto;
    }
    .search-open {
      display: grid;
    }
    .field {
      display: none;
    }
    :global(header.searching) .field {
      display: flex;
      position: absolute;
      inset: auto max(1rem, env(safe-area-inset-right)) auto max(1rem, env(safe-area-inset-left));
      top: calc(env(safe-area-inset-top) + 0.5rem); /* centred in the 3.5rem bar */
      gap: 0.6rem;
      z-index: 1;
    }
    :global(header.searching) .glass {
      left: 0.8rem;
    }
    kbd {
      display: none;
    }
    .search-cancel {
      display: block;
      flex: none;
      padding: 0.4rem 0.1rem;
      border: 0;
      background: none;
      font: inherit;
      font-size: 0.9rem;
      color: var(--accent);
      cursor: pointer;
    }
    input {
      font-size: 1rem; /* no zoom-on-focus in iOS Safari */
    }
    .results {
      left: 0;
      right: 0;
      width: auto;
    }
  }
</style>
