---
// Review mode: verdicts on facts, kept in this browser until they're sent as
// one pre-filled GitHub issue (see src/lib/review.ts). Turned on from the menu,
// or by opening the review queue (/review/).
//
// Anywhere a fact can be reviewed (a "how we know" popover, an item in the
// queue) holds a <review-controls data-key="id@hash"> element, which draws its
// own Right / Wrong / Not sure buttons and note. CSS shows them only while
// review mode is on. Clicks are delegated from the document, so it works in
// panels and in the queue's island alike.
//
// A submission has to fit in one link, so once the pending verdicts would make
// it too long, the next one is turned away with a prompt to submit first.
import { url } from "../lib/url.ts"
---

<div class="review-bar" hidden>
  <a class="rb-queue" href={url("/review/")}><span class="wide">Review queue</span><span class="narrow">Queue</span></a>
  <span class="rb-count" aria-live="polite"></span>
  <button type="button" class="pill rb-submit">Submit<span class="wide"> on GitHub</span></button>
  <button type="button" class="pill rb-clear">Clear</button>
</div>

<script>
  import { NOTE_MAX, fits, isPendingKey, readPending, submissionUrl, writePending, type Verdict } from "../lib/review.ts"

  let pending = readPending()
  const on = () => document.documentElement.dataset.review === "on"

  const bar = document.querySelector<HTMLElement>(".review-bar")!
  const [count, submit, clear] = [".rb-count", ".rb-submit", ".rb-clear"].map((s) => bar.querySelector<HTMLButtonElement>(s)!)

  const LABELS: [Verdict, string][] = [
    ["right", "Right"],
    ["wrong", "Wrong"],
    ["unsure", "Not sure"],
  ]

  // Shows one fact's pending verdict, if any. A note typed before choosing a
  // verdict stays in the field until a button takes it.
  function show(el: HTMLElement) {
    const mine = pending[el.dataset.key!]
    for (const b of el.querySelectorAll<HTMLButtonElement>("[data-verdict]"))
      b.setAttribute("aria-pressed", String(mine?.verdict === b.dataset.verdict))
    const note = el.querySelector<HTMLInputElement>(".rc-note")!
    if (mine && document.activeElement !== note) note.value = mine.note ?? ""
    el.closest(".queue-item")?.classList.toggle("pending", !!mine)
  }

  customElements.define(
    "review-controls",
    class extends HTMLElement {
      connectedCallback() {
        if (!this.firstChild)
          this.innerHTML = `
            <p class="rc-q">Is this right as the site shows it?</p>
            <div class="rc-buttons" role="group" aria-label="Your verdict">
              ${LABELS.map(([v, l]) => `<button type="button" class="pill" data-verdict="${v}" aria-pressed="false">${l}</button>`).join("")}
            </div>
            <input type="text" class="field rc-note" maxlength="${NOTE_MAX}" placeholder="Why? A verse helps (optional)" aria-label="Note" />
            <p class="rc-msg" aria-live="polite"></p>`
        show(this)
      }
    },
  )

  function showBar() {
    const n = Object.keys(pending).length
    bar.hidden = !on()
    count.textContent = n ? `${n} to submit` : "Nothing to submit yet"
    submit.disabled = clear.disabled = n === 0
  }
  function refresh() {
    pending = readPending()
    showBar()
    for (const el of document.querySelectorAll<HTMLElement>("review-controls")) show(el)
  }

  // Changes one fact's verdict, unless the submission would no longer fit.
  function set(el: HTMLElement, change: (p: typeof pending) => void) {
    const next = structuredClone(pending)
    change(next)
    const fit = fits(next)
    el.querySelector(".rc-msg")!.textContent = fit ? "" : "That's all one submission can hold. Submit these first, then carry on."
    if (fit) {
      pending = next
      writePending(pending)
      showBar()
    }
    show(el)
  }

  document.addEventListener("click", (e) => {
    const button = (e.target as Element).closest<HTMLButtonElement>("review-controls [data-verdict]")
    if (!button) return
    const el = button.closest<HTMLElement>("review-controls")!
    const key = el.dataset.key!
    const verdict = button.dataset.verdict as Verdict
    const note = el.querySelector<HTMLInputElement>(".rc-note")!.value.trim()
    set(el, (p) => {
      if (p[key]?.verdict === verdict) delete p[key] // a second click takes it back
      else p[key] = { verdict, ...(note ? { note } : {}) }
    })
  })

  // A note is kept with its verdict, once there is one.
  document.addEventListener("change", (e) => {
    const input = (e.target as Element).closest<HTMLInputElement>("review-controls .rc-note")
    const el = input?.closest<HTMLElement>("review-controls")
    if (!input || !el || !pending[el.dataset.key!]) return
    const note = input.value.trim()
    set(el, (p) => {
      if (note) p[el.dataset.key!].note = note
      else delete p[el.dataset.key!].note
    })
  })

  // Submitting keeps the verdicts here until they're cleared, in case the
  // issue isn't sent after all.
  submit.addEventListener("click", () => window.open(submissionUrl(pending), "_blank", "noopener"))
  clear.addEventListener("click", () => {
    const n = Object.keys(pending).length
    if (!n || !confirm(`Clear ${n === 1 ? "this verdict and its note" : `these ${n} verdicts and their notes`}? Do this once you've submitted them.`)) return
    writePending({})
    for (const note of document.querySelectorAll<HTMLInputElement>("review-controls .rc-note")) note.value = ""
    refresh()
  })

  // The menu's switch, and other tabs.
  addEventListener("review", showBar)
  addEventListener("storage", (e) => isPendingKey(e.key) && refresh())

  showBar()
</script>

<style is:global>
  /* Shared by review mode and the queue: a round button, and a text field. */
  .pill {
    font: inherit;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--paper);
    color: var(--ink);
    cursor: pointer;
  }
  .pill:disabled {
    opacity: 0.5;
    cursor: default;
  }
  .field {
    font: inherit;
    font-size: 16px; /* no zoom on focus in iOS */
    padding: 0.35rem 0.55rem;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 8px;
  }

  .review-bar {
    position: fixed;
    z-index: 45;
    left: 50%;
    bottom: calc(1rem + env(safe-area-inset-bottom));
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    white-space: nowrap;
    max-width: calc(100vw - 2rem);
    padding: 0.45rem 0.6rem 0.45rem 1rem;
    background: var(--surface);
    border: 1px solid var(--gold);
    border-radius: 999px;
    box-shadow: 0 10px 30px rgb(40 30 15 / 0.18);
    font: 0.85rem/1.2 var(--sans);
    color: var(--ink-2);
  }
  .review-bar[hidden],
  .review-bar .narrow {
    display: none;
  }
  /* Phones: one row across the bottom, with shorter labels. */
  @media (max-width: 560px) {
    .review-bar {
      left: max(1rem, env(safe-area-inset-left));
      right: max(1rem, env(safe-area-inset-right));
      transform: none;
      max-width: none;
      gap: 0.5rem;
      border-radius: 14px;
    }
    .review-bar .rb-count {
      flex: 1;
    }
    .review-bar .wide {
      display: none;
    }
    .review-bar .rb-queue .narrow {
      display: inline;
    }
  }
  /* Room at the end of a page, so the bar never hides the last fact. */
  html[data-review="on"] main.column {
    padding-bottom: 7rem;
  }
  .review-bar a {
    color: var(--ink);
    font-weight: 600;
  }
  .review-bar .rb-submit {
    background: var(--gold);
    border-color: var(--gold);
    color: var(--paper);
  }

  review-controls {
    display: block;
    margin-top: 0.75rem;
    padding-top: 0.65rem;
    border-top: 1px solid var(--rule);
    font: 0.85rem/1.4 var(--sans);
  }
  html:not([data-review="on"]) review-controls {
    display: none;
  }
  .rc-q {
    margin: 0 0 0.4rem;
    font-weight: 600;
  }
  .rc-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  review-controls [aria-pressed="true"] {
    background: var(--verdict);
    border-color: var(--verdict);
    color: var(--paper);
  }
  [data-verdict="right"] {
    --verdict: var(--gold);
  }
  [data-verdict="wrong"] {
    --verdict: var(--accent);
  }
  [data-verdict="unsure"] {
    --verdict: var(--ink-3);
  }
  .rc-note {
    box-sizing: border-box;
    width: 100%;
    margin-top: 0.45rem;
  }
  .rc-msg {
    margin: 0.35rem 0 0;
    color: var(--accent);
  }
  .rc-msg:empty {
    display: none;
  }
</style>
