---
// Labelled rows of related records ("Parents: Amram, Jochebed"). Rows with
// nothing in them are left out. A row's optional third element names the
// fact behind each link, so it gets its "how we know" marker.
import type { Entity } from "../lib/data/load.ts"
import EntityLinks from "./EntityLinks.astro"

type FactOf = (e: Entity) => string | undefined
interface Props {
  rows: [string, Entity[], FactOf?][]
  context?: string // the page's record id
}
const rows = Astro.props.rows.filter(([, items]) => items.length > 0)
---

{
  rows.length > 0 && (
    <dl class="relations">
      {rows.map(([term, items, factOf]) => (
        <>
          <dt>{term}</dt>
          <dd>
            <EntityLinks items={items} factOf={factOf} context={Astro.props.context} />
          </dd>
        </>
      ))}
    </dl>
  )
}

<style>
  .relations {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 0.4rem 1rem;
    margin: 1.5rem 0 0;
  }
  dt {
    color: var(--ink-3);
    font-size: 0.88rem;
    padding-top: 0.1rem;
  }
  dd {
    margin: 0;
  }
  @media (max-width: 520px) {
    .relations {
      grid-template-columns: 1fr;
      gap: 0 1rem;
    }
    dt {
      margin-top: 0.5rem;
    }
  }
</style>
