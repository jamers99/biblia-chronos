---
// Labelled rows of related records ("Parents: Amram, Jochebed"). Rows with
// nothing in them are left out.
import type { Entity } from "../lib/data/load.ts"
import EntityLinks from "./EntityLinks.astro"

interface Props {
  rows: [string, Entity[]][]
}
const rows = Astro.props.rows.filter(([, items]) => items.length > 0)
---

{
  rows.length > 0 && (
    <dl class="relations">
      {rows.map(([term, items]) => (
        <>
          <dt>{term}</dt>
          <dd>
            <EntityLinks items={items} />
          </dd>
        </>
      ))}
    </dl>
  )
}

<style>
  .relations {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 0.4rem 1rem;
    margin: 0;
  }
  dt {
    color: var(--ink-3);
    font-size: 0.88rem;
    padding-top: 0.1rem;
  }
  dd {
    margin: 0;
  }
  @media (max-width: 520px) {
    .relations {
      grid-template-columns: 1fr;
      gap: 0 1rem;
    }
    dt {
      margin-top: 0.5rem;
    }
  }
</style>
