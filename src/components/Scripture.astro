---
// Where a record appears in Scripture, cited by book. Long lists (Jesus, David,
// Jerusalem) fold behind a summary so the page stays scannable. Each verse run
// links out to read it (see passageUrl), in a new tab.
import type { ScriptureRef } from "../lib/data/schema.ts"
import { books } from "../lib/data/load.ts"
import { citeRefs, passageUrl } from "../lib/scripture.ts"

interface Props {
  refs?: ScriptureRef[]
}
const cited = citeRefs(Astro.props.refs ?? [], books)
const verses = cited.reduce((n, c) => n + c.count, 0)
const fold = verses > 40
const summary = `${verses} ${verses === 1 ? "verse" : "verses"} in ${cited.length} ${cited.length === 1 ? "book" : "books"}`
---

{
  cited.length > 0 && (
    <section>
      <h2>In Scripture</h2>
      <details open={!fold}>
        <summary>{summary}</summary>
        <ul class="refs">
          {cited.map((c) => (
            <li>
              <strong>{c.book.name}</strong>{" "}
              {c.chapters.map((runs, i) => (
                <>
                  {i > 0 && "; "}
                  {runs.map((run, j) => (
                    <>
                      {j > 0 && ", "}
                      <a href={passageUrl(c.book, run)} target="_blank" rel="noopener">{run.label}</a>
                    </>
                  ))}
                </>
              ))}
            </li>
          ))}
        </ul>
      </details>
    </section>
  )
}

<style>
  summary {
    cursor: pointer;
    color: var(--ink-2);
  }
  .refs {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0;
    font-size: 0.92rem;
    line-height: 1.7;
  }
  .refs strong {
    font-weight: 600;
  }
  .refs a {
    color: inherit;
    text-decoration-color: var(--rule);
    text-underline-offset: 0.2em;
  }
  .refs a:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }
</style>
