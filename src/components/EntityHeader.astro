---
// Title block shared by every record page: kind, name, draft marker, the facts
// (a short definition list passed as [term, value] pairs), and a one-sentence
// lede from the description.
import type { Entity } from "../lib/data/load.ts"
import { tallyOf } from "../lib/data/load.ts"
import { summarize } from "../lib/format.ts"
import HowWeKnow from "./HowWeKnow.astro"

interface Props {
  entity: Entity
  kindLabel: string
  subtitle?: string
  // [term, value], or [term, value, fact id] for a value with evidence
  facts?: [string, string | undefined, string?][]
}
const { entity, kindLabel, subtitle, facts = [] } = Astro.props
const lede = summarize(entity.description)
const shown = facts.filter(([, v]) => v)
// How far this record's facts have been checked, by anyone: details in Sources.
const t = tallyOf(entity.id)
const checked = t.facts - t.unchecked
---

<header>
  <p class="kind">{kindLabel}</p>
  <h1>
    {entity.name}
    {
      entity.status === "draft" && (
        <span class="badge" title="Theographic marks this record as a work in progress">draft</span>
      )
    }
    {
      t.facts > 0 && (
        <a class="badge checks" href="#sources" title="How many of this record's facts have been checked against Scripture, and by whom">
          {checked} of {t.facts} checked
        </a>
      )
    }
  </h1>
  {subtitle && subtitle !== entity.name && <p class="subtitle">{subtitle}</p>}
  {
    shown.length > 0 && (
      <dl>
        {shown.map(([term, value, fact]) => (
          <div>
            <dt>{term}</dt>
            <dd>
              {value}
              {fact && <HowWeKnow fact={fact} context={entity.id} />}
            </dd>
          </div>
        ))}
      </dl>
    )
  }
  {lede && <p class="lede">{lede}</p>}
</header>

<style>
  .lede {
    font: 1.15rem/1.55 var(--serif);
    color: var(--ink-2);
    max-width: var(--measure);
    margin: 1.25rem 0 0;
  }
  .subtitle {
    margin: -0.25rem 0 0;
    color: var(--ink-2);
  }
  .kind {
    margin: 0 0 0.25rem;
  }
  h1 .badge {
    margin-left: 0.5rem;
    vertical-align: middle;
  }
  .badge.checks {
    text-decoration: none;
    text-transform: none;
    letter-spacing: 0;
  }
  dl {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    margin: 1rem 0 0;
  }
  dt {
    font-size: 0.75rem;
    color: var(--ink-3);
  }
  dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }
</style>
