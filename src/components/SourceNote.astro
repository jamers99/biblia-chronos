---
// Provenance, on every record page: which source the record comes from.
import { source } from "../lib/data/load.ts"

interface Props {
  sourceId: string
}
const s = source(Astro.props.sourceId)
---

{
  s && (
    <p class="source">
      Source: {s.url ? <a href={s.url}>{s.title}</a> : s.title}
      {s.license && ` (${s.license})`}
    </p>
  )
}

<style>
  .source {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
    font-size: 0.8rem;
    color: var(--ink-3);
  }
  .source a {
    color: inherit;
  }
</style>
