---
// Opening the review queue turns review mode on (see ReviewMode.astro).
---

<script is:inline>
  if (document.documentElement.dataset.review !== "on") {
    document.documentElement.dataset.review = "on"
    try {
      localStorage.setItem("review", "on")
    } catch {}
    addEventListener("DOMContentLoaded", () => {
      const toggle = document.querySelector(".review-toggle")
      if (toggle) toggle.checked = true
      dispatchEvent(new CustomEvent("review", { detail: true }))
    })
  }
</script>
